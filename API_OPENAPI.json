{"openapi":"3.1.0","info":{"title":"OmniCast Engine API","version":"1.0"},"paths":{"/api/render/{channel_id}":{"post":{"summary":"Start Render","description":"Start a full video render for a channel (background). Uses the channel's\nstyle/voice/subtitle via --channel, Flow images, a fresh Flow project.","operationId":"start_render_api_render__channel_id__post","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}},{"name":"script","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Script"}},{"name":"beat_words","in":"query","required":false,"schema":{"type":"integer","default":35,"title":"Beat Words"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/render/status":{"get":{"summary":"Render Status","description":"Live render status (stages, per-shot thumbnails, credits, log, video).","operationId":"render_status_api_render_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/render/latest":{"get":{"summary":"Render Latest","description":"Latest render outputs (relative to /media): video, thumbnail, title.","operationId":"render_latest_api_render_latest_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/credits":{"get":{"summary":"Get Credits","description":"Flow credit balance (image gen is free; Veo video costs). None if unread.","operationId":"get_credits_api_credits_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/status":{"get":{"summary":"Get Status","description":"System overview KPIs.","operationId":"get_status_api_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/channels":{"get":{"summary":"Get Channels","description":"All channels with live pipeline status.","operationId":"get_channels_api_channels_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}},"post":{"summary":"Create Channel","description":"Create a new channel configuration.","operationId":"create_channel_api_channels_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/channels/{channel_id}":{"get":{"summary":"Get Channel","description":"Get full JSON config of a specific channel.","operationId":"get_channel_api_channels__channel_id__get","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"put":{"summary":"Update Channel","description":"Update an existing channel configuration.","operationId":"update_channel_api_channels__channel_id__put","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":true,"title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}},"delete":{"summary":"Delete Channel","description":"Delete a channel configuration.","operationId":"delete_channel_api_channels__channel_id__delete","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/pipeline":{"get":{"summary":"Get Pipeline","description":"Active jobs + recent results.\n\nEach active job is enriched with computed `elapsed_seconds` and `eta_seconds`\n(linear extrapolation from progress velocity) so the operator can answer\n\"how long until this finishes?\" without leaving the dashboard.","operationId":"get_pipeline_api_pipeline_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/errors":{"get":{"summary":"Get Errors","description":"Recent background-task failures with full Python traceback.\n\nPolled by the dashboard so the operator never needs to SSH+tail logs.\nReturns provenance envelope.","operationId":"get_errors_api_errors_get","parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":20,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/errors/clear":{"post":{"summary":"Post Errors Clear","description":"Operator-triggered cleanup of the error log.\n\nAudit-trail: we don't delete the file silently; the timestamp of the clear is\nrecorded so the operator can see \"this log was reset at X\" on next page load.","operationId":"post_errors_clear_api_errors_clear_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/niches":{"get":{"summary":"Get Niches","description":"Latest niche discovery results.","operationId":"get_niches_api_niches_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/budget":{"get":{"summary":"Get Budget","description":"Cost tracking.","operationId":"get_budget_api_budget_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/vault":{"get":{"summary":"Get Vault","description":"List vault niches with optional filters.","operationId":"get_vault_api_vault_get","parameters":[{"name":"status","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Status"}},{"name":"market","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Market"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/vault/save-all":{"post":{"summary":"Vault Save All","description":"Save all niches from latest niche_results.json to vault.","operationId":"vault_save_all_api_vault_save_all_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/vault/health-check":{"post":{"summary":"Vault Health Check","description":"Run health check on all watching niches.","operationId":"vault_health_check_api_vault_health_check_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/vault/archive/{niche_id}":{"post":{"summary":"Vault Archive","description":"Archive a niche.","operationId":"vault_archive_api_vault_archive__niche_id__post","parameters":[{"name":"niche_id","in":"path","required":true,"schema":{"type":"string","title":"Niche Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/vault/create-channel/{niche_id}":{"post":{"summary":"Vault Create Channel","description":"Auto-generate a complete channel configuration from a vault niche.","operationId":"vault_create_channel_api_vault_create_channel__niche_id__post","parameters":[{"name":"niche_id","in":"path","required":true,"schema":{"type":"string","title":"Niche Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/infra":{"get":{"summary":"Get Infra","description":"Infrastructure health — DB + Redis pings + worker heartbeats from Redis.\n\nAuto-polled by the dashboard (5 s). Fail-soft: never raises; surfaces failures in\nthe response body so the operator can see WHY a component is down, not just THAT.","operationId":"get_infra_api_infra_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/system/state":{"get":{"summary":"Get System State","description":"Kill-switch state (Redis key `system:pipeline_paused`).\n\nPolled by the topbar indicator (4 s). Fail-soft: if Redis unreachable returns\n`paused=False, redis_available=False` so the operator can SEE that the kill-switch\nis currently unenforceable (which is itself an intervention signal).","operationId":"get_system_state_api_system_state_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/system/pause":{"post":{"summary":"Post System Pause","description":"Engage kill-switch. Workers MUST check `system:pipeline_paused` before pulling jobs.\n\nIdempotent — calling on already-paused system is safe.\nReturns the new state so the client never has to re-query.","operationId":"post_system_pause_api_system_pause_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/system/resume":{"post":{"summary":"Post System Resume","description":"Disengage kill-switch.","operationId":"post_system_resume_api_system_resume_post","requestBody":{"content":{"application/json":{"schema":{"additionalProperties":true,"type":"object","title":"Body"}}}},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/discover-niches":{"post":{"summary":"Trigger Niche Discovery","description":"Trigger niche discovery in background.","operationId":"trigger_niche_discovery_api_discover_niches_post","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}}}},"/api/run/{channel_id}":{"post":{"summary":"Trigger Channel Run","description":"Trigger phase-1 discovery for a channel.","operationId":"trigger_channel_run_api_run__channel_id__post","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/run/{channel_id}/cancel":{"post":{"summary":"Cancel Channel Run","description":"Force-clear any active job for a channel (kill-switch for stuck runs).","operationId":"cancel_channel_run_api_run__channel_id__cancel_post","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/run/{channel_id}/script":{"post":{"summary":"Trigger Channel Script","description":"Trigger phase-2 script generation. Optional ?topic= overrides auto-select.","operationId":"trigger_channel_script_api_run__channel_id__script_post","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}},{"name":"topic","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Topic"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/discovery/{channel_id}":{"get":{"summary":"Get Discovery","description":"Return Phase 1 discovery results (topic queues).\n\nFirst checks output/runs/{channel_id}/ for phase1_discovery.json files.\nFalls back to pipeline_state.json recent_results for newer runs that save\ntopic_queue directly in pipeline events.","operationId":"get_discovery_api_discovery__channel_id__get","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/scripts/{channel_id}":{"get":{"summary":"List Scripts","description":"List all saved script variants for a channel, including per-scene data and debate rounds.\n\nHandles two layouts:\n  - New: output/scripts/{channel_id}/{topic_slug}/variant_*.json\n  - Old: output/scripts/{channel_id}/variant_*.json  (flat, no topic subdir)","operationId":"list_scripts_api_scripts__channel_id__get","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/run/{channel_id}/log":{"get":{"summary":"Get Live Log","description":"Live agent event log for an active (or recently completed) run.","operationId":"get_live_log_api_run__channel_id__log_get","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/run/{channel_id}/images":{"post":{"summary":"Trigger Channel Images","description":"Trigger phase-3 image generation for a channel.\n\nbackend=browser  → CloakBrowser + Gemini Pro web (free, uses Pro subscription)\nbackend=api      → Imagen 4 via Gemini API ($0.03/image, needs GOOGLE_API_KEY)\n\nOptionally pass ?script_json=<absolute_path> to target a specific file.\nPass ?max_scenes=N to cap scenes (0 = all).","operationId":"trigger_channel_images_api_run__channel_id__images_post","parameters":[{"name":"channel_id","in":"path","required":true,"schema":{"type":"string","title":"Channel Id"}},{"name":"script_json","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Script Json"}},{"name":"max_scenes","in":"query","required":false,"schema":{"type":"integer","default":0,"title":"Max Scenes"}},{"name":"backend","in":"query","required":false,"schema":{"type":"string","default":"browser","title":"Backend"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}}},"components":{"schemas":{"HTTPValidationError":{"properties":{"detail":{"items":{"$ref":"#/components/schemas/ValidationError"},"type":"array","title":"Detail"}},"type":"object","title":"HTTPValidationError"},"ValidationError":{"properties":{"loc":{"items":{"anyOf":[{"type":"string"},{"type":"integer"}]},"type":"array","title":"Location"},"msg":{"type":"string","title":"Message"},"type":{"type":"string","title":"Error Type"},"input":{"title":"Input"},"ctx":{"type":"object","title":"Context"}},"type":"object","required":["loc","msg","type"],"title":"ValidationError"}}}}