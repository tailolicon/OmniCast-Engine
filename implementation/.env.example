# Database
DATABASE_URL=postgresql+asyncpg://omnicast:dev_password@localhost:5432/omnicast

# RabbitMQ
RABBITMQ_URL=amqp://omnicast:dev_password@localhost:5672/

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Claude writer backend. "cli" uses the logged-in Claude Code subscription and
# records $0 marginal API cost. Set "api" explicitly only when per-token API
# billing is intended.
OMNICAST_CLAUDE_BACKEND=cli

# --- unit_first narrative flow: model roles -----------------------------
# TEMPORARY while the DeepSeek quota is exhausted. 1 = every narrative role
# runs on the Claude CLI and ZERO DeepSeek calls are made (no health probe,
# no first primary attempt). Unset/0 = normal DeepSeek-first routing with
# Claude fallbacks; switching back needs no code change.
OMNICAST_NARRATIVE_CLAUDE_ONLY=0
# 1 = writer + release challenger on claude-opus-4-8 at max effort.
OMNICAST_NARRATIVE_MAX_QUALITY=0
# Per-role overrides (defaults shown). Effort is a property of the ROLE:
# planning/judging are structured and bounded; prose is where depth pays.
# Allowed effort: low | medium | high | xhigh | max
#OMNICAST_NARRATIVE_PLANNER_MODEL=claude-sonnet-5
#OMNICAST_NARRATIVE_PLANNER_EFFORT=medium
#OMNICAST_NARRATIVE_WRITER_MODEL=claude-opus-4-8
#OMNICAST_NARRATIVE_WRITER_EFFORT=max
#OMNICAST_NARRATIVE_JUDGE_FALLBACK_MODEL=claude-sonnet-5
#OMNICAST_NARRATIVE_JUDGE_EFFORT=medium
#OMNICAST_NARRATIVE_CHALLENGER_MODEL=claude-opus-4-8
#OMNICAST_NARRATIVE_CHALLENGER_EFFORT=max
#OMNICAST_NARRATIVE_ANNOTATION_MODEL=claude-sonnet-5

# --- ChatGPT Web writer (Shiro chatgpt-bridge relay) --------------------
# Drafts scripts on the operator's ChatGPT subscription through the Shiro
# relay (loopback, default 127.0.0.1:23158). Requires the Shiro stack running
# with a logged-in chatgpt.com tab. Applies to the WRITER only, in every flow
# (claude_first, debate, unit_first writer role); judges keep their providers.
#OMNICAST_SCRIPT_WRITER_PROVIDER=chatgpt_web
# Credentials auto-read from .ShiroRuntime/state/chatgpt-relay.env; override:
#CHATGPT_WEB_BASE_URL=http://127.0.0.1:23158
#CHATGPT_WEB_API_TOKEN=
#CHATGPT_WEB_RELAY_ENV=/home/tailolicon/Projects/.ShiroRuntime/state/chatgpt-relay.env
# ChatGPT UI picker labels (see GET /models, /efforts on the relay):
#CHATGPT_WEB_MODEL=GPT-5.6 Thinking
#CHATGPT_WEB_EFFORT=high

# --- Script Farm (cloud-drafted scripts, no laptop) ---------------------
# ChatGPT drafts scripts straight into the repo via scriptfarm/WORKER_START.md.
# 1 = before drafting locally, import a drafted/approved farm script matching
# this channel+topic (git pull first); the local critic still re-scores it.
#OMNICAST_SCRIPT_FARM=1
CLAUDE_API_KEY=

# Google AI (Imagen 4 / Veo via Gemini API — get key at aistudio.google.com)
GOOGLE_API_KEY=your_google_ai_key_here

# Media Pipeline
MEDIA_IMAGE_PROVIDER=gemini
MEDIA_VIDEO_PROVIDER=gemini
MEDIA_IMAGE_MODEL=gemini-2.5-flash-image-preview
MEDIA_VIDEO_MODEL=veo-3.0-generate-001

# Mode
OMNICAST_MODE=dry_run  # production | dry_run | staging

# NAS
NAS_MOUNT_PATH=/Volumes/NAS
NAS_FALLBACK_PATH=/tmp/omnicast_local
